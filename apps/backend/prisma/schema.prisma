generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  username  String?   @unique
  password  String
  language  String    @default("es")
  widgets   Widget[]
  tabs      Tab[]
  lists     TodoList[]
  events    CalendarEvent[]
  tags      Tag[]
  tables    DataTable[]
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Tab {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  widgets   Widget[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

model Widget {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tabId    String?
  tab      Tab?     @relation(fields: [tabId], references: [id], onDelete: Cascade)
  type     String
  config   String   @default("{}")
  position String   @default("{\"x\":0,\"y\":0,\"w\":300,\"h\":200}")
  zIndex    Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model TodoList {
  id       String     @id @default(uuid())
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String
  items    TodoItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TodoItem {
  id        String   @id @default(uuid())
  listId    String
  list      TodoList @relation(fields: [listId], references: [id], onDelete: Cascade)
  text      String
  completed Boolean  @default(false)
  order     Int
  urgency   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Bloque del calendario: una tarea con hora dentro de un dia.
///
/// `date` es texto `YYYY-MM-DD` y no DateTime a proposito. Es el mismo criterio
/// que esta en CalendarEventDto: el dia es la unidad con la que piensa el
/// usuario, y un timestamp obliga a fijar zona horaria en cada lectura, con el
/// clasico evento corrido de dia al cambiar el horario de verano.
///
/// La hora va en `startMin` (0..1439) y no en una columna `time`: asi el dia
/// completo es `date` a secas y la grilla de horas es una division.
model CalendarEvent {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String
  startMin    Int
  durationMin Int       @default(60)
  title       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  /// UNA etiqueta por bloque. `onDelete: SetNull` para que borrar una etiqueta
  /// le SAQUE la etiqueta a sus bloques en vez de borrarlos: los bloques
  /// sobreviven y quedan sin etiqueta.
  tagId       String?
  tag         Tag?      @relation(fields: [tagId], references: [id], onDelete: SetNull)

  /// Toda lectura de la vista es un rango sobre `date`, asi que el indice va
  /// por ahi y no por `createdAt`: es la unica consulta que se hace siempre.
  @@index([userId, date])
  /// El filtro por etiqueta es un `WHERE tagId = ?` sobre el mes entero. Con el
  /// indice del rango alcanza, pero este evita recorrer el mes para contar.
  @@index([tagId])
}

/// Etiqueta creada por el usuario.
///
/// Es entidad y no un texto dentro del evento a proposito: renombrarla tiene que
/// ser UNA operacion, y con el nombre adentro de cada bloque habria que
/// reescribir todos los que la usan.
///
/// `name` guarda como la escribio el usuario; `nameLower` fuerza la unicidad.
/// SQLite no tiene collation case-insensitive por defecto, asi que sin la
/// columna auxiliar "Work" y "work" coexistirian como dos etiquetas.
model Tag {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  nameLower String
  /// El `id` de `TAG_COLORS` (packages/shared), o `''` cuando la paleta ya no
  /// tenia uno libre. Texto y no enum porque la paleta vive en el frontend y
  /// agregar un tono no debe ser una migracion.
  ///
  /// `''` y no `null`: la columna es NOT NULL y hacerla nullable pide una
  /// migracion, y con la base en `db push` una migracion aca significa resetearla.
  /// `''` se lee como "sin color" en `tagColorHex` y el DTO lo normaliza a `null`,
  /// asi que ninguna vista tiene que saber del truco. El default queda como estaba
  /// para no mover el DDL de la tabla.
  color     String   @default("#4E8FD4")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    CalendarEvent[]

  @@unique([userId, nameLower])
}

/// Tabla de datos propia del usuario, con columnas que el usuario define.
///
/// El esquema y los datos van SEPARADOS en dos modelos en vez de meter las filas
/// como un array JSON dentro de esta. Con el array, cada lectura trae la tabla
/// entera y dos ediciones simultaneas se pisan sobre el mismo blob.
///
/// `columns` es el ESQUEMA y `DataRow.values` son los datos de cada fila contra
/// ese esquema. No hay relacion Prisma entre las dos: una columna no tiene filas,
/// es una clave dentro del JSON.
///
/// Sin `deletedAt` a proposito. La tabla se referencia desde el `config` del
/// widget --su id vive ahi--, no desde la fila de `Widget`, asi que sobrevive a que
/// el widget se borre y se restaure.
model DataTable {
  id     String   @id @default(uuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  /// JSON con `[{ id, name, type, width?, options?, format?, currency? }]`, donde
  /// `type` es uno de `COLUMN_TYPES` --`text`, `number`, `checkbox`, `date`,
  /// `status` o `select`--, `width` es el ancho en px que fijo el usuario, y las
  /// otras tres son los ajustes de `select` y `number` (ver `normalizeColumns`).
  /// Texto y no `Json` por el mismo criterio que `Widget.config`: el schema no
  /// usa el tipo `Json` en ninguna parte y SQLite lo soporta en cualquier forma
  /// que no sea la que ya se usa aca.
  columns String    @default("[]")
  rows    DataRow[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

/// Fila de una `DataTable`: un registro, no un fragmento.
///
/// Una fila por registro es lo que permite paginar, ordenar y filtrar sin cargar
/// la tabla entera. `position` es un Float y no un Int para que reordenar no
/// obligue a renumerar el resto: el nuevo `position` es el promedio de los dos
/// vecinos.
model DataRow {
  id       String   @id @default(uuid())
  tableId  String
  table    DataTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  /// JSON con `{ [columnId]: string | number | null }`. Las claves son los `id`
  /// de `DataTable.columns`, no los nombres: asi renombrar una columna no toca
  /// ni un valor.
  values   String   @default("{}")
  position Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tableId, position])
}
